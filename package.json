{
  "name": "agent-ready-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "auth": "node --env-file=.env --import tsx src/twitch/auth.ts",
    "whois": "node --env-file=.env --import tsx src/twitch/whois.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "replay": "node --import tsx src/replay.ts",
    "record": "node --env-file=.env --import tsx scripts/record.ts"
  },
  "dependencies": {
    "robots-parser": "^3.0.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
